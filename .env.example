# Copy this file to .env and replace the local-only placeholders before startup.
# Never use these values for a deployed or shared environment.
RAILCONNECT_DB_NAME=railconnect
RAILCONNECT_DB_SCHEMA=railconnect
RAILCONNECT_DB_USERNAME=
RAILCONNECT_DB_PASSWORD=
RAILCONNECT_DB_URL=jdbc:postgresql://localhost:54329/railconnect
RAILCONNECT_COMPOSE_DB_URL=jdbc:postgresql://db:5432/railconnect
POSTGRES_PORT=54329

# Backend-only Supabase Auth configuration; get keys from the Supabase project settings.
RAILCONNECT_SUPABASE_URL=
RAILCONNECT_SUPABASE_ANON_KEY=
RAILCONNECT_SUPABASE_SERVICE_ROLE_KEY=

# Simulated merchant integration only. Keep disabled unless demo credentials and origin are verified.
RAILCONNECT_PAY_DHRUVA_BANK_ENABLED=false
RAILCONNECT_PAY_DHRUVA_BANK_BASE_URL=https://dhruva-bank.vercel.app
RAILCONNECT_PAY_DHRUVA_BANK_API_KEY=
RAILCONNECT_PAY_DHRUVA_BANK_API_SECRET=
RAILCONNECT_PAY_PASSENGER_ORIGIN=https://irctc-rho.vercel.app
RAILCONNECT_PAY_REQUESTS_PER_MINUTE=6

# Public frontend setting; not a credential.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Exact development origins only. Do not use a wildcard.
RAILCONNECT_CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003
RAILCONNECT_SESSION_COOKIE_SECURE=false
# Set a stable random 32+ byte key outside local development; never commit the real value.
RAILCONNECT_AUTH_THROTTLE_KEY=

# Ticket QR signing configuration. Generate an Ed25519 key pair and inject these
# values through a deployment secret manager; never commit real key material.
RAILCONNECT_TICKET_SIGNING_KEY_ID=
RAILCONNECT_TICKET_SIGNING_PRIVATE_KEY=
RAILCONNECT_TICKET_VERIFICATION_PUBLIC_KEY=
RAILCONNECT_TICKET_VERIFICATION_TOKEN_LIFETIME=PT24H
RAILCONNECT_TICKET_PUBLIC_VERIFICATION_ORIGIN=http://localhost:3001/verify-ticket
# Optional: uncomment and set to an installed Unicode TrueType font.
# RAILCONNECT_TICKET_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
RAILCONNECT_TICKET_ISSUANCE_SWEEP_MS=10000
RAILCONNECT_TICKET_VERIFICATION_REQUESTS_PER_MINUTE=20

# Optional cache; it is disabled by default and is never authoritative.
RAILCONNECT_REDIS_ENABLED=false
RAILCONNECT_REDIS_HOST=localhost
RAILCONNECT_REDIS_PORT=6379
RAILCONNECT_REDIS_USERNAME=
RAILCONNECT_REDIS_PASSWORD=
RAILCONNECT_REDIS_SSL=false
RAILCONNECT_REDIS_TIMEOUT_MS=1000
RAILCONNECT_REDIS_CONNECT_TIMEOUT_MS=1000

RAILCONNECT_OPENAPI_ENABLED=true
