flowchart TB
  subgraph Dev["Local development / CI"]
    FE[Next.js static build]
    BE[Spring Boot container]
    PG[(Disposable PostgreSQL)]
    FE --> BE --> PG
    TEST[Test payment adapter]
    BE --> TEST
  end
  subgraph Demo["Optional free preview — synthetic data only"]
    EDGE[Cloudflare Pages static assets]
    APP[Render Free web service; sleeps / ephemeral FS]
