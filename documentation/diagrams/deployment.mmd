    EDGE -->|HTTPS API| APP --> DB
  end
  subgraph Future["Future production reference — NOT approved or free"]
    CDN[Static CDN]
    LB[Load balancer / gateway]
    API[Stateless app replicas]
    DATA[(Durable PostgreSQL + independent backups)]
    OUT[Outbox workers]
    PAY[Approved payment provider]
    CDN --> LB --> API --> DATA
    API --> PAY
    DATA --> OUT
  end
  Dev -. no real data .-> Demo
  Demo -. only after separate cost/security approval .-> Future
